# SaagarSathi server — copy to `.env` and fill in
# Canonical location: saagarsathi/server/.env
# (A root saagarsathi/.env ALSO works as fallback, but server/.env wins.)

# LLM Explainer (NVIDIA NIM, OpenAI-compatible). https://build.nvidia.com
# Without it the app still answers via the deterministic rule template.
# NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional
PORT=3000

# Optional — Open-Meteo overrides (defaults already point to public APIs)
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# Bhashini voice (TTS/STT) + translation — https://bhashini.gov.in (Udyat dashboard -> API Keys)
# BHASHINI_USER_ID = grey project id under your app name (NOT the UDYAT KEY)
# BHASHINI_USER_ID=
# BHASHINI_ULCA_API_KEY = the "UDYAT KEY" value
# BHASHINI_ULCA_API_KEY=
# BHASHINI_INFERENCE_API_KEY = the "INFERENCE" value (sent as Authorization header)
# BHASHINI_INFERENCE_API_KEY=
# Optional endpoint overrides:
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_COMPUTE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
